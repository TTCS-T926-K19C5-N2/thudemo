# Local development only. Copy to .env and replace angle-bracket placeholders.
POSTGRES_USER=<LOCAL_DB_USER>
POSTGRES_PASSWORD=<LOCAL_DB_PASSWORD>
POSTGRES_DB=<LOCAL_DB_NAME>
DATABASE_URL=postgresql://<LOCAL_DB_USER>:<LOCAL_DB_PASSWORD>@localhost:5432/<LOCAL_DB_NAME>?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Existing authentication scaffold; T-01 does not implement authentication.
JWT_SECRET=<LOCAL_ONLY_SECRET>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
