# PORTABLE Sprint4-5 DEMO (not production). Copy this file to .env at clone root.
# Required, private, server-only: choose two DIFFERENT values, at least12chars. DB password: letters/digits/_/- only.
POSTGRES_PASSWORD=<CHOOSE_DEMO_DB_PASSWORD>
DEMO_PASSWORD=<CHOOSE_DEMO_ACCOUNT_PASSWORD>
# Optional Compose namespace. Change for a separate dataset; never reuse staging name.
COMPOSE_PROJECT_NAME=thudemo-demo
# Optional public browser origin and host port; must agree. Runtime, not baked into JS.
PUBLIC_URL=http://localhost:3488
WEB_PORT=3488
# Optional default loopback. LAN needs HTTPS reverse proxy and trusted certificate; see guide.
DEMO_BIND_ADDRESS=127.0.0.1
# Optional Mailpit UI loopback port. SMTP remains private mailpit:1025, no Internet delivery.
MAIL_UI_PORT=8138
# Optional database identity, server-only. Internal service hostname fixed postgres; no DB host port.
POSTGRES_USER=demo
POSTGRES_DB=thudemo_demo
# Optional explicit fake seed. true initializes only missing data; false skips seed.
DEMO_SEED=true
# Optional YYYY-MM-DD (Vietnam timezone). Blank chooses today's date at prepare time.
DEMO_DATE=
# Optional new alphanumeric batch to ADD fresh event/tickets without resetting old ones.
DEMO_BATCH=1
# Mode, mock payment, catcher transport, worker and internal URLs are explicit in compose.demo.yml.
# Secrets and persistent Ed25519 keys are initialized once inside named demo_keys volume.
# No private key/credentials may be put in NEXT_PUBLIC_* or committed.
# For historical non-Compose local setup see .env.development.example; do not mix profiles.

# Optional accounting recipient for payment/refund business alerts.
# Missing recipient produces a visible FAILED delivery; never a fake sent log.
ACCOUNTANT_EMAIL=
# Starting staging limits, per 60-second window. Tune from measured legitimate traffic.
BOOKING_HOLD_ACCOUNT_LIMIT=60
BOOKING_HOLD_IP_LIMIT=6000
BOOKING_ORDER_ACCOUNT_LIMIT=15
BOOKING_ORDER_IP_LIMIT=1500
