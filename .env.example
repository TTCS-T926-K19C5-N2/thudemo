# Local development only. Copy to .env and replace angle-bracket placeholders.
POSTGRES_USER=<LOCAL_DB_USER>
POSTGRES_PASSWORD=<LOCAL_DB_PASSWORD>
POSTGRES_DB=<LOCAL_DB_NAME>
DATABASE_URL=postgresql://<LOCAL_DB_USER>:<LOCAL_DB_PASSWORD>@localhost:5432/<LOCAL_DB_NAME>?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Browser origin allowed to send state-changing requests with a session cookie.
WEB_ORIGIN=http://localhost:3000

# Local fake accounts only; required when running pnpm --filter api seed:demo.
DEMO_ADMIN_PASSWORD=<LOCAL_DEMO_ADMIN_PASSWORD>
DEMO_ORGANIZER_PASSWORD=<LOCAL_DEMO_ORGANIZER_PASSWORD>

# Payment Gateway Configuration (Story S-18 MoMo Sandbox)
PAYMENT_GATEWAY=momo
