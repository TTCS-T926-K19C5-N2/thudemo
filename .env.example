# Local development only. Copy to .env and replace angle-bracket placeholders.
POSTGRES_USER=<LOCAL_DB_USER>
POSTGRES_PASSWORD=<LOCAL_DB_PASSWORD>
POSTGRES_DB=<LOCAL_DB_NAME>
DATABASE_URL=postgresql://<LOCAL_DB_USER>:<LOCAL_DB_PASSWORD>@localhost:5432/<LOCAL_DB_NAME>?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Browser origin allowed to send state-changing requests with a session cookie.
WEB_ORIGIN=http://localhost:3000

# Local fake accounts only; required when running pnpm --filter api seed:demo.
DEMO_ADMIN_PASSWORD=<LOCAL_DEMO_ADMIN_PASSWORD>
DEMO_ORGANIZER_PASSWORD=<LOCAL_DEMO_ORGANIZER_PASSWORD>

# Payment Gateway Configuration (Story S-18 MoMo Sandbox & Story S-19 Mock Gateway)
# Chọn 'momo' cho MoMo Sandbox hoặc 'mock' cho cổng giả lập nội bộ (mock chỉ dùng cho dev/test, bị cấm ở production)
PAYMENT_GATEWAY=momo
PAYMENT_WEBHOOK_SECRET=<PAYMENT_WEBHOOK_SECRET>
MOMO_PARTNER_CODE=<MOMO_PARTNER_CODE>
MOMO_ACCESS_KEY=<MOMO_ACCESS_KEY>
MOMO_SECRET_KEY=<MOMO_SECRET_KEY>
MOMO_ENDPOINT=https://test-payment.momo.vn
ACCOUNTANT_EMAIL=accounting@example.com
# Mock Gateway Webhook Delay (Story S-22): 0 = gửi ngay, > 0 = trì hoãn (ms), -1 = không bao giờ gửi (chỉ áp dụng khi PAYMENT_GATEWAY=mock)
MOCK_WEBHOOK_DELAY_MS=0

# Order Expiry Scheduler (Story S-23): Chu kỳ quét đơn hết hạn (giây), mặc định 60s
ORDER_EXPIRY_JOB_INTERVAL_SECONDS=60
ORDER_EXPIRY_MODE=off

# S-26/S-30: persistent server-only Ed25519 issuer; never generate keys at startup.
# Set these on the API server only. Keep private files outside repository/images.
# SCANNER_KEY_ID=production-k1
# SCANNER_SIGNING_PRIVATE_KEY_FILE=<ABSOLUTE_SERVER_PRIVATE_PEM_PATH>
# SCANNER_PUBLIC_KEYS={"production-k1":"<PUBLIC_SPKI_PEM>"}
# Retain old PUBLIC keys in this JSON during ordinary rotation; see docs/S26_SIGNED_QR_CONTRACT.md.
