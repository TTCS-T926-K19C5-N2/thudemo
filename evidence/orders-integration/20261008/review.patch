+          <div>
+            <h1>Chi tiết đơn hàng</h1>
+          </div>
+        </header>
+        {error ? (
+          <OrderError
+            error={error}
+            returnTo={`${path}?page=${page}`}
+            retry={retry}
+          />
+        ) : !order ? (
+          <OrderLoading detail />
