@@ -0,0 +1,38 @@
+import { createServer } from "node:http";
+import next from "next";
+import { signLoginPeer, LOGIN_PEER_HEADER } from "shared/login-peer";
+
+const dev = process.argv.includes("--dev");
+const hostname = process.env.WEB_HOST ?? "127.0.0.1";
+const port = Number(
+  process.env.WEB_PORT ?? (dev ? 3000 : (process.env.PORT ?? 3000)),
+);
+const secret = process.env.AUTH_PROXY_SECRET;
+// Fail before listening if the attestation key is absent or a placeholder.
+signLoginPeer("127.0.0.1", secret);
+const app = next({ dev, dir: import.meta.dirname, hostname, port });
+await app.prepare();
+const handler = app.getRequestHandler();
+createServer((request, response) => {
+  // Own the TCP peer boundary. Never trust inbound X-Forwarded-For or an
+  // attestation supplied by the caller, even when its signature is otherwise valid.
+  delete request.headers[LOGIN_PEER_HEADER];
+  try {
+    const path = new URL(request.url ?? "/", "http://localhost").pathname;
+    if (request.method === "POST" && path === "/api/auth/login") {
+      request.headers[LOGIN_PEER_HEADER] = signLoginPeer(
+        request.socket.remoteAddress,
+        secret,
+      );
+    }
+  } catch {
+    response.writeHead(400).end("Invalid request");
+    return;
+  }
+  void Promise.resolve(handler(request, response)).catch(() => {
+    if (!response.headersSent) response.writeHead(500);
+    response.end();
+  });
+}).listen(port, hostname, () =>
+  console.log(`Web listening on ${hostname}:${port}`),
+);
