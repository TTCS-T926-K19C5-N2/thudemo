+          container_name: "sprint1-tests-redis-20261015",
+          ports: ["127.0.0.1:16386:6379"],
+          labels: { "sprint1.review": "20261015" },
+          healthcheck: {
+            test: ["CMD", "redis-cli", "ping"],
+            interval: "2s",
+            timeout: "3s",
+            retries: 30,
+          },
+        },
+      },
+      volumes: { "test-db": {} },
+    },
+    null,
+    2,
+  ),
+);
+run("test-dependencies", "docker", [
+  "compose",
+  "-p",
+  "sprint1-tests-20261015",
+  "-f",
+  ".sprint1-local/tests-compose.json",
+  "up",
+  "-d",
+  "--wait",
+]);
+run(
+  "test-migration",
+  "corepack",
+  ["pnpm", "--filter", "api", "exec", "prisma", "migrate", "deploy"],
