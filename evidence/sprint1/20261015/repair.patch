+  writeFileSync(resolve(out, "gates.json"), JSON.stringify(results, null, 2));
+  console.log(name, result.status === 0 ? "PASS" : "FAIL");
+  if (result.status !== 0) throw Error(`${name} failed; see private log`);
+}
+const existing = spawnSync("docker", ["ps", "-a", "--format", "{{.Names}}"], {
+  encoding: "utf8",
+}).stdout;
+if (!existing.includes("sprint1-tests-pg-20261015")) await free(15434);
+if (!existing.includes("sprint1-tests-redis-20261015")) await free(16386);
+for (const name of [
+  "sprint1-tests-pg-20261015",
+  "sprint1-tests-redis-20261015",
+  "sprint1-tests-qr-pg-20261015",
