generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  password          String
  isEmailVerified   Boolean    @default(false)
  activationToken   String?
  activationExpires DateTime?  @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)
  userRoles         UserRole[]
  sessions          Session[]
  events            Event[]    @relation("OrganizerEvents")
  holdSessions      HoldSession[]
  orders            Order[]

  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  tokenHash String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Event {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  description String
  location    String
  posterPath  String?
  mobilePosterPath String?
  bannerPath String?
  categoryLabel String?
  status      String     @default("DRAFT") // DRAFT, PUBLISHED
  organizerId String     @db.Uuid
  organizer   User       @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  showtimes   Showtime[]
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([organizerId])
  @@map("events")
}

model Showtime {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  startTime DateTime @db.Timestamptz(3)
  seatMapId String? // Nullable for now as per S-04
  status ShowtimeStatus @default(DRAFT)
  structureLocked Boolean @default(false)
  seats Seat[]
  categories SeatCategory[]
  holdSessions HoldSession[]
  orders       Order[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([eventId])
  @@map("showtimes")
}

enum ShowtimeStatus {
  DRAFT
  ON_SALE
  CLOSED
}

model SeatCategory {
  id String @id @default(uuid()) @db.Uuid
  showtimeId String @db.Uuid
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  name String
  price Int?
  seats Seat[]
  @@unique([showtimeId, name])
  @@unique([id, showtimeId])
  @@map("seat_categories")
}

model Seat {
  id String @id @default(uuid()) @db.Uuid
  showtimeId String @db.Uuid
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  categoryId String @db.Uuid
  category SeatCategory @relation(fields: [categoryId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  row String
  seatNumber Int
  hold SeatHold?
  ticket Ticket?
  @@unique([id, showtimeId])
  @@unique([showtimeId, row, seatNumber])
  @@index([categoryId, showtimeId])
  @@map("seats")
}

model HoldSession {
  id String @id @default(uuid()) @db.Uuid
  showtimeId String @db.Uuid
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionHash String
  token String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  seats SeatHold[]
  @@unique([showtimeId, userId, sessionHash])
  @@unique([id, showtimeId])
  @@map("hold_sessions")
}

model SeatHold {
  seatId String @id @db.Uuid
  showtimeId String @db.Uuid
  seat Seat @relation(fields: [seatId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  holdSessionId String @db.Uuid
  holdSession HoldSession @relation(fields: [holdSessionId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  token String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  acquiredAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([seatId, showtimeId])
  @@index([expiresAt, seatId])
  @@index([holdSessionId, token])
  @@map("seat_holds")
}

model CatalogRevision {
  id Int @id
  version Int @default(0)
  @@map("catalog_revision")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  showtimeId    String      @db.Uuid
  showtime      Showtime    @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  totalAmount   Int
  status        OrderStatus @default(PAID)
  customerEmail String
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  tickets       Ticket[]
  emailLogs     EmailLog[]

  @@index([userId])
  @@index([showtimeId])
  @@map("orders")
}

model Ticket {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seatId      String   @db.Uuid
  seat        Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  ticketCode  String   @unique
  qrCodeData  String
  qrCodeImage String?  @db.Text
  price       Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([seatId])
  @@index([orderId])
  @@map("tickets")
}

model EmailLog {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipient String
  subject   String
  attempts  Int         @default(1)
  status    EmailStatus @default(PENDING)
  lastError String?     @db.Text
  sentAt    DateTime?   @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  @@index([orderId])
  @@map("email_logs")
}
