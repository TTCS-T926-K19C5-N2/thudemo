generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ORGANIZER
  STAFF
  ACCOUNTANT
  ADMIN
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  role              Role      @default(BUYER)
  isEmailVerified   Boolean   @default(false)
  activationToken   String?
  activationExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            Event[]   @relation("OrganizerEvents")
  seatHolds         SeatHold[]
  tickets           Ticket[]
}

model Event {
  id          String     @id @default(uuid())
  name        String
  description String
  location    String
  status      String     @default("DRAFT") // DRAFT, PUBLISHED
  organizerId String
  organizer   User       @relation("OrganizerEvents", fields: [organizerId], references: [id])
  showtimes   Showtime[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Showtime {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id])
  startTime  DateTime
  seatMapId  String?  // Nullable for now as per S-04
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seatCategories SeatCategory[]
  seats          Seat[]
}

model SeatCategory {
  id          String   @id @default(uuid())
  showtimeId  String   @map("showtime_id")
  name        String
  color       String?  @default("#3B82F6")
  price       Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  showtime    Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seats       Seat[]

  @@index([showtimeId])
  @@map("seat_categories")
}

model Seat {
  id             String        @id @default(uuid())
  showtimeId     String        @map("showtime_id")
  seatCategoryId String?       @map("seat_category_id")
  seatRow        String        @map("seat_row")
  seatNumber     Int           @map("seat_number")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  showtime       Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatCategory   SeatCategory? @relation(fields: [seatCategoryId], references: [id], onDelete: SetNull)
  holds          SeatHold[]
  tickets        Ticket[]

  @@unique([showtimeId, seatRow, seatNumber], name: "unique_seat_per_showtime")
  @@index([showtimeId])
  @@map("seats")
}

model SeatHold {
  id        String   @id @default(uuid())
  seatId    String   @map("seat_id")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([seatId])
  @@index([expiresAt])
  @@map("seat_holds")
}

model Ticket {
  id        String   @id @default(uuid())
  seatId    String   @map("seat_id")
  userId    String   @map("user_id")
  status    String   @default("PAID") // PAID, CANCELLED, USED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([seatId])
  @@map("tickets")
}