# Copy outside Git to ../.env.monitoring.local. Never paste secrets into chat.
# Load only for an explicitly authorized external test; local setup needs no provider.
S43_EXTERNAL_TEST_APPROVED=false
S43_SMTP_HOST=<SMTP_HOST>
S43_SMTP_PORT=587
S43_SMTP_FROM=<SENDER_EMAIL>
S43_SMTP_USER=<SMTP_USER>
S43_SMTP_PASSWORD=<APP_PASSWORD_OR_SMTP_CREDENTIAL>
S43_EMAIL_TO=<APPROVED_RECIPIENT_EMAIL>
S43_TELEGRAM_BOT_TOKEN=<BOT_TOKEN>
S43_TELEGRAM_CHAT_ID=<APPROVED_PRIVATE_CHAT_ID>
